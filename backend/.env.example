# MATERIALS_DIR=/absolute/path/to/docs/curriculum
# UPLOAD_DIR=./var/uploads
# EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# MAX_UPLOAD_BYTES=20971520
