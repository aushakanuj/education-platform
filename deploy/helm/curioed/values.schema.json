{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "api": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "tag": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "(?i)^latest$"
              }
            }
          },
          "required": ["tag"]
        }
      }
    },
    "web": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "tag": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "(?i)^latest$"
              }
            }
          },
          "required": ["tag"]
        }
      }
    },
    "llmMock": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "(?i):latest$"
          }
        }
      }
    }
  }
}
