ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./education.db
# Optional PostgreSQL stack: docker compose up -d, then use:
# DATABASE_URL=postgresql+asyncpg://education:education@localhost:5432/education
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
JWT_SECRET_KEY=replace-with-a-long-random-secret
LOCAL_STORAGE_PATH=.local-storage
